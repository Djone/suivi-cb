# Dockerfile pour le backend Node.js
FROM node:24-alpine@sha256:ebfe2f90462722a7a4de65e91990e97fe0d401c70e0e762c5b53302f905ec1c1 AS dependencies

# Définir le répertoire de travail
WORKDIR /app

# Copier les fichiers package.json et package-lock.json
COPY backend/package*.json ./

# Installer les dépendances de production uniquement
# Cette étape est placée après la copie de package.json pour bénéficier du cache Docker
RUN npm ci --omit=dev

FROM node:24-alpine@sha256:ebfe2f90462722a7a4de65e91990e97fe0d401c70e0e762c5b53302f905ec1c1
WORKDIR /app
# Patch the runtime OS and exclude package managers from the running image.
RUN apk upgrade --no-cache \
    && rm -rf /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack \
       /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack \
       /usr/local/bin/yarn /usr/local/bin/yarnpkg /usr/local/bin/pnpm /usr/local/bin/pnpx
COPY --from=dependencies /app/node_modules ./node_modules

# Copier le reste des fichiers du backend. Cette copie s'assure que toutes les modifications de code sont prises en compte.
COPY backend/ .

# Créer le répertoire pour la base de données
RUN mkdir -p /app/data /app/logs && chown 1028:100 /app/data /app/logs

# Same identity as the NAS data directory; source files remain read-only to it.
USER 1028:100

# Exposer le port du backend
EXPOSE 3001

# Variables d'environnement par défaut
ENV NODE_ENV=production
ENV DOCUMENTATION_DISABLED=true
ENV PORT_BACK=3001
ENV DB_PATH=/app/data/database.db

# Démarrer le serveur
CMD ["node", "server.js"]
