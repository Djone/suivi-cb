{
  "devDependencies": {
    "baseline-browser-mapping": "^2.11.25",
    "concurrently": "^9.2.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.9.9"
  },
  "name": "suivi-cb",
  "version": "2.2.0-dev",
  "main": "index.js",
  "scripts": {
    "start": "call scripts\\start-dev.bat",
    "start:app": "concurrently \"npm run start:backend\" \"npm run start:frontend\"",
    "start:keycloak": "call scripts\\start-keycloak-dev.bat",
    "start:backend": "cd backend && npm run start",
    "start:frontend": "cd frontend && ng serve --proxy-config proxy.conf.json",
    "start:all": "npm start",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "cd backend && npm test",
    "test:frontend": "cd frontend && npm test -- --watch=false --browsers=ChromeHeadless",
    "test:watch": "concurrently \"npm run test:backend:watch\" \"npm run test:frontend:watch\"",
    "test:backend:watch": "cd backend && npm run test:watch",
    "test:frontend:watch": "cd frontend && npm test",
    "test:coverage": "npm run test:backend:coverage && npm run test:frontend:coverage",
    "test:backend:coverage": "cd backend && npm run test:coverage",
    "test:frontend:coverage": "cd frontend && npm test -- --code-coverage --watch=false --browsers=ChromeHeadless",
    "version": "node scripts/gen-version.js && git add frontend/src/app/version.ts",
    "build": "NODE_ENV=production ng build --configuration production",
    "build:dev": "NODE_ENV=development ng build",
    "release:dry-run": "node scripts/release-orchestrator.js dry-run",
    "release:prepare": "node scripts/release-orchestrator.js prepare",
    "release:deploy": "node scripts/release-orchestrator.js deploy",
    "release:full": "node scripts/release-orchestrator.js full",
    "release:rollback": "node scripts/release-orchestrator.js rollback",
    "release:candidate": "node scripts/release-candidate.js ship",
    "release:candidate:package": "node scripts/release-candidate.js package",
    "release:candidate:transfer": "node scripts/release-candidate.js transfer",
    "release:candidate:approve": "node scripts/release-candidate.js approve",
    "test:candidate": "node --test scripts/tests/release-candidate.test.cjs scripts/tests/candidate-inventory.test.cjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": ""
}
